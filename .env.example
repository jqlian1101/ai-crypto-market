# ==============================================================================
# AI Crypto Market Intelligence & Analysis Platform —— 环境变量模板
#
# PRD 第 32.2 / 32.4 节：.env.example 必须包含**全部**配置项（敏感项留空并注释）。
# 加载优先级（低→高）：代码默认值 → .env/.env.local → 环境变量 → DB 用户偏好
#
# 安全约束（32.1 / 34.2）：
#   - 密钥、token、白名单、dry-run 开关只能来自环境变量
#   - .env 已在 .gitignore 中；本文件只含空值
#   - 校验失败必须阻止进程启动（32.3）
# ==============================================================================

# ---------- 应用基础 ----------
APP_ENV=local
# 用户时区：免打扰时段、日报时间、定时任务的用户语义时间
APP_TIMEZONE=Asia/Shanghai
# 后端绑定地址。默认仅回环；暴露到非回环必须开启鉴权（34.5）
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
# 必需：PostgreSQL 连接串
DATABASE_URL=
# 必需：Redis 连接串
REDIS_URL=
FRONTEND_URL=http://localhost:3000
# 短链基准地址；公网可达时必须设置为真实地址
DASHBOARD_PUBLIC_BASE_URL=

# ---------- 鉴权（34 章） ----------
AUTH_ENABLED=true
# 必需（AUTH_ENABLED=true 时）：Bearer token
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=
# 可选：只存哈希，进程启动时比对
AUTH_TOKEN_SHA256=
AUTH_RATE_LIMIT_PER_MIN=10
# 逗号分隔的允许来源 IP；未设置时不启用该检查
ALLOWED_IPS=
# 企微回调的一次性公网入口（34.6）
PUBLIC_CALLBACK_ENABLED=false
PUBLIC_CALLBACK_PORT=8081
PUBLIC_CALLBACK_TOKEN=

# ---------- 行情采集（29 章） ----------
MARKET_SYMBOLS=BTCUSDT,ETHUSDT
MARKET_TYPES=SPOT,USDM_FUTURES
MARKET_TIMEFRAMES=5m,15m,1h,4h
# 启用 1m 则相关异动规则才启用
MARKET_ENABLED_INTERVALS_1M=false
MARKET_WS_RECONNECT_MAX_MS=30000
MARKET_OI_POLL_SECONDS=60
MARKET_CROSSCHECK_SECONDS=300
MARKET_BACKFILL_ENABLED=true
MARKET_BACKFILL_MAX_KLINES=1000
MARKET_BOOK_SNAPSHOT_INTERVAL_SECONDS=60
MARKET_BOOK_DEPTH_LEVELS=20
# 资金费率历史轮询间隔（秒）；OI 无 WS 推送，只能轮询
MARKET_FUNDING_POLL_SECONDS=600
# 聚合成交保留天数（27.3：原始高频数据短期保留）
MARKET_TRADE_RETENTION_DAYS=90
CLOCK_SYNC_INTERVAL_SECONDS=600
CLOCK_SKEW_ALERT_MS=5000
# 币安访问代理，形如 http://127.0.0.1:7892；留空表示直连。
# REST 与 WS 共用此地址；仅支持 http/https（走 CONNECT 隧道）。
MARKET_PROXY=

# ---------- 异动与规则（22 章） ----------
ANOMALY_SCAN_INTERVAL_SECONDS=60
ANOMALY_RULE_CONFIG_PATH=config/base.toml
ANOMALY_EVAL_HORIZONS=1h,4h
# 逗号分隔的规则 ID，用于临时停用
ANOMALY_RULES_DISABLED=

# ---------- 通知（22.4 / 22.5） ----------
FEISHU_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
WECOM_APP_ENABLED=false
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_TO_USER=
WECOM_TO_PARTY=
WECOM_TO_TAG=
WECOM_APP_MSG_TYPE=text
WECOM_BOT_ENABLED=false
WECOM_BOT_WEBHOOK_URL=
NOTIFY_DAILY_QUOTA=60
# 按 APP_TIMEZONE 解释
NOTIFY_QUIET_HOURS=00:00-07:00
NOTIFY_CRITICAL_BYPASS_QUIET=false
NOTIFY_CHANNEL_PRIORITY=feishu,wecom_app
NOTIFY_DELIVERY_MODE=broadcast
# 例：CRITICAL:wecom_app,INFO:feishu
NOTIFY_SEVERITY_ROUTING=
NOTIFY_QUOTA_COUNTING_MODE=per_event
NOTIFY_DEDUP_TTL_SECONDS=86400
NOTIFY_COOLDOWN_CRITICAL_SECONDS=300
NOTIFY_COOLDOWN_WARN_SECONDS=1800
NOTIFY_MAX_RETRIES=4
NOTIFY_RETRY_BACKOFF=1s,3s,10s,30s
NOTIFY_AI_MERGE_WINDOW_SECONDS=30
NOTIFY_WECOM_TOKEN_REFRESH_MARGIN_SECONDS=300

# ---------- LLM（24 章） ----------
LLM_PROVIDER_DEFAULT=cloud
LLM_CLOUD_BASE_URL=
LLM_CLOUD_API_KEY=
LLM_PROVIDER_LOCAL_BASE_URL=http://ollama:11434/v1
LLM_PROVIDER_LOCAL_MODEL=
# 本地 Ollama 默认无鉴权，此处仅为兼容 OpenAI 兼容端点；按安全约定留空
LLM_PROVIDER_LOCAL_API_KEY=
LLM_TIER_LIGHT_MODEL=
LLM_TIER_STANDARD_MODEL=
LLM_TIER_DEEP_MODEL=
# 支持 enable_thinking 的兼容端点可设 false；其他端点留空
LLM_ENABLE_THINKING=
# false 时 LLM 请求忽略环境代理；行情网络配置不受影响
LLM_TRUST_ENV=true
# 日 token 硬上限
LLM_DAILY_TOKEN_BUDGET=
# 日费用硬上限（美元）
LLM_DAILY_COST_BUDGET_USD=
LLM_MAX_INPUT_TOKENS=24000
LLM_MAX_OUTPUT_TOKENS=4000
LLM_AGENT_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_SCHEMA_REPAIR_ATTEMPTS=1
LLM_ANALYSIS_TOTAL_BUDGET_SECONDS=180

# ---------- 调度（23 章） ----------
SCHEDULER_ENABLED=true
# cron 一律按 UTC 解释
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_BACKFILL_SECONDS=86400
SCHEDULER_LOCK_MODE=postgres_advisory
SCHEDULER_WORKER_POOL=4

# ---------- Freqtrade（P1） ----------
FREQTRADE_ENABLED=false
FREQTRADE_API_BASE_URL=
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=
# 启动时强制校验 dry_run=true，否则拒绝启动（7.7）
FREQTRADE_DRY_RUN_ENFORCE=true
# 必须固定版本，禁止 latest
FREQTRADE_IMAGE_TAG=

# ---------- 可观测性（37 章） ----------
METRICS_ENABLED=true
METRICS_BIND=127.0.0.1:9100
METRICS_AUTH_REQUIRED=false
LOG_SAMPLING_RATE=1.0

# ---------- 备份与保留（27 章） ----------
BACKUP_ENABLED=true
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14
BACKUP_RESTORE_DRILL_ENABLED=true
RETENTION_ENABLED=true
